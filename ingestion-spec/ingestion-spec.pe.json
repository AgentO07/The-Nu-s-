{
    "type": "index_parallel",
    "spec": {
      "dataSchema": {
        "dataSource": "keywords_data",
        "timestampSpec": {
          "column": "timestamp",
          "format": "auto"
        },
        "dimensionsSpec": {
          "dimensions": ["file_id", "keyword"]
        },
        "metricsSpec": []
      },
      "ioConfig": {
        "type": "index_parallel",
        "inputSource": {
          "type": "local",
          "baseDir": "/path/to/data/",
          "filter": "*.pe.json"
        },
        "inputFormat": {
          "type": "json",
          "flattenSpec": {
            "useFieldDiscovery": true,
            "fields": [
              {
                "type": "path",
                "name": "keyword",
                "expr": "$[*]"
              }
            ]
          }
        }
      },
      "tuningConfig": {
        "type": "index_parallel",
        "maxRowsPerSegment": 5000000
      }
    }
  }

  



  